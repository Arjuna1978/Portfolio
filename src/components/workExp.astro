---
import { Image } from "astro:assets";
import DCS from "../../public/projects/DCS.png";
import SquareBear from "../../public/projects/SquareBear.png";
import Apkudo from "../../public/projects/Apkudo.png";
import SKFL from "../../public/projects/SKFL.png";
import ForceViz from "../../public/projects/ForceViz.png";
import VizFlo from "../../public/projects/vizflow.png";

interface Project {
  title: string;
  image: ImageMetadata;
  link: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "Government Licencing",
    image: DCS as ImageMetadata,
    link: "https://www.service.nsw.gov.au/guide/check-a-business-or-trade-licence",
    status: "$2.7 mil project ",
  },
  {
    title: "SquareBear",
    image: SquareBear as ImageMetadata,
    link: "https://app.squarebear.com.au/",
    status: "My 1st startup, good customer base",
  },
  {
    title: "Apkudo",
    image: Apkudo as ImageMetadata,
    link: "https://www.apkudo.com/platform-overview",
    status: "Successful robotics platform",
  },
  {
    title: "SKFL",
    image: SKFL as ImageMetadata,
    link: "https://skfl.tech/",
    status: "SKFL in BETA, first customers engaged",
  },
];
---

<section
  id="workExp"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">
      Companies I work with enjoy significant uplifts to their technology
      capabilities
    </h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Work examples</h3>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {
        projects.map((project) => (
          <div class="group">
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
            >
              <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
                <Image
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="flex items-center px-3">
                <div class="flex-grow">
                  <h4 class="text-2xl font-semibold">{project.title}</h4>
                  <span class="py-1 text-sm text-[var(--white-icon)]">
                    {project.status}
                  </span>
                </div>
                <div class="flex gap-2 ml-auto">
                  <a
                    target="_blank"
                    href={project.link}
                    aria-label="GitHub"
                    class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-7"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>
            </a>
          </div>
        ))
      }
    </div>
    <a
      target="_blank"
      href="https://www.linkedin.com/in/arjunavijayanayagam/"
      aria-label="linkedin"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
    >
      <span class="md:text-lg text-md">More experience details on</span>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="-66.9396 165.894 38.1 38.1"
        class="size-7"
      >
        <path
          d="m -66.040003,203.09417 -0.89958,-0.89958 v -17.25083 -17.25084 l 0.89958,-0.89958 0.89958,-0.89958 h 17.25084 17.25083 l 0.89958,0.89958 0.89959,0.89958 v 17.25084 17.25083 l -0.89959,0.89958 -0.89958,0.89959 h -17.25083 -17.25084 z m 34.81917,-18.15041 v -16.66875 h -16.66875 -16.66875 v 16.66875 16.66875 h 16.66875 16.66875 z m -25.66459,1.98437 v -5.95312 h 1.85209 1.85208 v 5.95312 5.95313 h -1.85208 -1.85209 z m 5.82084,0 v -5.95312 h 2.11666 2.11667 v 0.83987 0.83987 l 0.59531,-0.54223 c 0.96708,-0.88083 1.67057,-1.13751 3.11762,-1.13751 1.78392,0 3.04717,0.62538 3.91745,1.93937 0.68103,1.02824 0.70688,1.20812 0.79244,5.51489 l 0.0884,4.45199 h -2.13897 -2.13897 l -0.004,-3.50573 c -0.003,-2.28194 -0.11995,-3.7351 -0.33635,-4.1628 -0.39725,-0.78514 -1.43934,-1.20469 -2.3959,-0.96461 -1.19996,0.30117 -1.49718,1.32958 -1.49718,5.18041 v 3.45273 h -2.11667 -2.11666 z m -5.15938,-7.58156 c -2.02756,-1.10899 -1.26804,-3.92781 1.05834,-3.92781 2.26021,0 3.12431,2.83651 1.1717,3.84624 -0.88207,0.45614 -1.50365,0.47887 -2.23004,0.0816 z"
          fill="currentColor"></path>
      </svg>
    </a>
  </div>
</section>
